<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain models and interfaces — IBackupStrategy and friends. Deliberately
    has no project references and no framework dependencies: everything else
    depends on Core, Core depends on nothing.

    Overrides the solution-wide net10.0-windows default (D9) back to
    plain net10.0: this project has no Windows-specific dependency, and
    staying platform-neutral means the analyzer catches it if one creeps in.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Test visibility, not a dependency: the comment above is about project
    REFERENCES, and this adds none. It exists for the seams that let a test drive
    an arm this repository cannot produce where it is written - the build runs as
    root, so a rig that denies itself a file and then looks for it succeeds
    (T176). Services has carried the same line for the same reason.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="BedrockSentry.Tests" />
  </ItemGroup>

</Project>
