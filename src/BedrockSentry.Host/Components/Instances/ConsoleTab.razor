@* The live console for one instance: output, command input, and the same
   controls the Status tab carries. *@
@implements IAsyncDisposable

@using BedrockSentry.Core.Commands
@using BedrockSentry.Core.Diagnostics
@using BedrockSentry.Core.Instances
@using BedrockSentry.Core.Players
@using BedrockSentry.Services.Commands
@using BedrockSentry.Services.Instances
@using Microsoft.AspNetCore.Components.Web

@inject IJSRuntime JS
@inject CompletionData Completion
@inject IPlayerStore Players
@inject TimeProvider Time

@* D105. Console and Commands are two views of one tab. The console stays in the page
   while Commands is shown, hidden rather than removed, so its script, its history and
   its place in the output survive the switch. *@
<div class="view-bar">
    <nav class="view-switch" aria-label="Console views">
        <button type="button" class="@(view == ConsoleView.Console ? "active" : null)"
                aria-current="@(view == ConsoleView.Console ? "page" : null)"
                @onclick="() => ShowAsync(ConsoleView.Console)">
            Console
        </button>
        <button type="button" class="@(view == ConsoleView.Commands ? "active" : null)"
                aria-current="@(view == ConsoleView.Commands ? "page" : null)"
                @onclick="() => ShowAsync(ConsoleView.Commands)">
            Commands
            <span class="view-count">@CommandCount</span>
        </button>
        <button type="button" class="@(view == ConsoleView.TickingAreas ? "active" : null)"
                aria-current="@(view == ConsoleView.TickingAreas ? "page" : null)"
                @onclick="() => ShowAsync(ConsoleView.TickingAreas)">
            Ticking Areas
            @if (Supervisor.TickingAreas is { } read)
            {
                <span class="view-count">@read.List.InUse</span>
            }
        </button>
    </nav>

    <span class="view-bar-spacer"></span>

    @if (view == ConsoleView.Commands)
    {
        <span class="check-detail">What Tab completes on this server, and where it comes from</span>
    }
    else if (view == ConsoleView.TickingAreas)
    {
        <span class="check-detail">The areas this world keeps loaded with nobody near</span>
    }
</div>

@if (view == ConsoleView.TickingAreas)
{
    <TickingAreasView Supervisor="Supervisor" />
}

<div hidden="@(view != ConsoleView.Console)">
<div class="console-filters">
    <span class="console-filter-label">Filter</span>

    <label class="field-row">
        <input type="checkbox" checked="@Filters.ServerOutput"
               @onchange="e => SetAsync(Filters with { ServerOutput = Ticked(e) })" />
        <span>Server output</span>
    </label>

    <label class="field-row">
        <input type="checkbox" checked="@Filters.Joins"
               @onchange="e => SetAsync(Filters with { Joins = Ticked(e) })" />
        <span>Joins</span>
    </label>

    <label class="field-row">
        <input type="checkbox" checked="@Filters.Leaves"
               @onchange="e => SetAsync(Filters with { Leaves = Ticked(e) })" />
        <span>Disconnects</span>
    </label>

    <label class="field-row">
        <input type="checkbox" checked="@Filters.Deaths"
               @onchange="e => SetAsync(Filters with { Deaths = Ticked(e) })" />
        <span>Deaths</span>
    </label>

    @* The companion pack's commands an operator ran in game; vanilla commands print nothing. *@
    <label class="field-row">
        <input type="checkbox" checked="@Filters.OperatorCommands"
               @onchange="e => SetAsync(Filters with { OperatorCommands = Ticked(e) })" />
        <span>Operator commands</span>
    </label>

    @* No Chat box until the companion pack relays chat (D95); until then
       ConsoleFilters shows every chat line whatever Filters.Chat holds. *@

    @* One click for the view this whole feature exists to give: who is on the
       server and what they are doing, with the machine underneath them out of
       the way. *@
    <button type="button" class="btn btn-sm btn-secondary"
            @onclick="() => SetAsync(Filters.ServerOutput
                ? ConsoleFilters.PlayersOnly
                : ConsoleFilters.All)">
        @(Filters.ServerOutput ? "Players only" : "Show everything")
    </button>
</div>

@* T308: asked of the boxes as they are now, at every render. A count kept
   beside the lines went stale when a box changed and no new line arrived. *@
@if (Filters.HiddenSentence(lines) is { } hiddenSentence)
{
    <p class="console-hint" style="margin-top:0"><strong>@hiddenSentence</strong></p>
}

@if (gapped)
{
    @* D16: output evicted before this page read it. Saying so beats showing a
       seamless history that is missing the middle. *@
    <p class="console-gap">
        Some output was produced faster than this page could read it and has scrolled
        out of the buffer. The full transcript is on disk.
    </p>
}

<div class="console-output" id="console-output">
    @* Filtered here rather than when the lines are read from the buffer. Doing
       it at read time would drop the hidden lines on the floor, and turning a
       category back on would show only what arrived from that moment on — which
       looks like it works, and quietly loses the history you turned it on for. *@
    @{
        var shown = lines.Where(Visible).ToList();
        var fold = ConsoleSaveFold.Of(shown);
        var notices = ConsoleNoticeFold.Of(shown);
    }
    @foreach (var line in shown)
    {
        @if (fold.Hides(line, openedManifests) || notices.Hides(line, noticeChoices))
        {
        }
        else if (line.Origin is ConsoleOrigin.Launch)
        {
            @* A rule rather than another line. A restart drops hundreds of lines
               of startup on top of hundreds that look exactly the same, and
               without a break it is easy to read the previous run's fault as
               this one's. *@
            <div class="console-launch">
                <span class="console-launch-label">
                    @ClockText.TimeWithSeconds(line.ReceivedUtc.ToLocalTime()) · @line.DisplayText
                </span>
            </div>
        }
        else
        {
            <div class="console-line console-@line.Origin.ToString().ToLowerInvariant() @ConsoleLineStyle.LevelClass(line) @ConsoleLineStyle.KindClass(line)">
                <span class="console-time">@ClockText.TimeWithSeconds(line.ReceivedUtc.ToLocalTime())</span>
                @* One character wide and always present, blank where a line has
                   no mark, so every message starts in the same column. It is
                   also the half of the scheme that survives being pasted into a
                   bug report, where the colour does not. *@
                <span class="console-glyph">@ConsoleLineStyle.Glyph(line)</span>
                <span class="console-text">@(line.DisplayText)@if (fold.Under(line) is { } manifest)
                    {
                        @* ON5: the save query's file list folds under this line. *@
                        var open = openedManifests.Contains(manifest.Sequence);
                        <button type="button" class="console-fold" aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => ToggleManifest(manifest.Sequence)">@ConsoleSaveFold.Label(manifest, open)</button>
                    }
                    else if (notices.Under(line) is { } notice)
                    {
                        @* ON2, T406: a boxed notice folds under its opening line; the choice is per banner and instance, and kept. *@
                        var open = ConsoleNoticeFold.IsOpen(notice, noticeChoices);
                        <button type="button" class="console-fold" aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => ToggleNotice(notice.Banner, !open)">@ConsoleNoticeFold.Label(open)</button>
                    }</span>
            </div>
        }
    }
</div>

@* The input belongs to console-completion.js: keys, history, the list, the grey
   preview and the usage line. It sends through SendFromBrowser, so what may be sent
   and the reply to a failed send stay here. No @bind: the script owns the value, and a
   render writing it back would undo a Tab. *@
<div class="console-input">
    <div class="cc-wrap">
        <div class="cc-ghost" id="@GhostId" aria-hidden="true" hidden><span id="@GhostTypedId"></span><span class="cc-ghost-rest" id="@GhostRestId"></span></div>
        <input id="@InputId"
               class="form-control"
               placeholder="@(CanSend ? "Type a server command; Tab completes it" : "The server is not running")"
               disabled="@(!CanSend)"
               autocomplete="off"
               autocapitalize="off"
               spellcheck="false"
               role="combobox"
               aria-autocomplete="list"
               aria-expanded="false"
               aria-controls="@ListId"
               aria-describedby="@UsageId" />
    </div>
    <div class="cc-list" id="@ListId" role="listbox" aria-label="Completions" hidden></div>
    <button type="button" class="btn btn-primary" id="@SendId" disabled="@(!CanSend)">Send</button>
</div>

<div class="cc-usage" id="@UsageId" aria-live="polite"></div>

@if (sendError is not null)
{
    <p class="console-fault">@sendError</p>
}

<p class="console-hint">
    Commands go straight to the server, exactly as typed. Tab takes a suggestion, Esc
    closes the list, and up and down arrows walk your history.
</p>
</div>

@if (view == ConsoleView.Commands && completion is { } data)
{
    <div class="data-box">
        @foreach (var row in SourceRows(data))
        {
            <div class="data-row">
                <span class="@row.BadgeClass">@row.BadgeText</span>
                <div>
                    <strong>@row.Title</strong>
                    <span class="data-what">
                        @foreach (var (text, code) in row.Runs)
                        {
                            @if (code)
                            {
                                <code>@text</code>
                            }
                            else
                            {
                                @text
                            }
                        }
                    </span>
                </div>
            </div>
        }
        <p class="data-note">@CompletionSources.NotCompleted</p>
    </div>

    <div class="ref-tools">
        <input class="form-control" type="search" placeholder="Filter commands, aliases or descriptions"
               aria-label="Filter commands"
               value="@filter" @oninput="e => filter = e.Value as string ?? string.Empty" />
        <span class="ref-count">@ReferenceCount(data)</span>
    </div>

    <div class="ref">
        @foreach (var (command, addon) in Reference(data))
        {
            <details>
                <summary>
                    <code>@command.Name</code>
                    @if (command.Aliases.Count > 0)
                    {
                        <span class="ref-aliases">also @(string.Join(", ", command.Aliases))</span>
                    }
                    @if (addon is not null)
                    {
                        <span class="addon-badge" title="@addon">add-on</span>
                    }
                    <span class="ref-desc">@command.Description</span>
                </summary>
                <pre>@(string.Join("\n", command.Forms.Select(f => f.Line)))</pre>
            </details>
        }
    </div>
}

@code {
    /// Bounded independently of the buffer: the buffer holds what the server said,
    /// this holds what one browser can render before the DOM becomes the bottleneck.
    private const int MaxRenderedLines = 500;

    /// How often the names completion offers are sent again without a join or a
    /// leave to prompt it: an allowlist edited by hand, or a player seen on another
    /// server. Counted in polls of 500 ms.
    private const int PlayersEveryPolls = 20;

    // One console is on the page at a time, so the ids are fixed, like console-output.
    private const string InputId = "console-command";
    private const string ListId = "console-completions";
    private const string UsageId = "console-usage";
    private const string GhostId = "console-ghost";
    private const string GhostTypedId = "console-ghost-typed";
    private const string GhostRestId = "console-ghost-rest";
    private const string SendId = "console-send";

    private enum ConsoleView
    {
        Console,
        Commands,
        TickingAreas,
    }

    [Parameter, EditorRequired]
    public InstanceSupervisor Supervisor { get; set; } = default!;

    /// Held by the page rather than here so it survives switching instances and
    /// tabs. A filter that reset every time you looked at another server would
    /// be worse than no filter.
    [Parameter]
    public ConsoleFilters Filters { get; set; } = ConsoleFilters.All;

    [Parameter]
    public EventCallback<ConsoleFilters> FiltersChanged { get; set; }

    private readonly List<ConsoleLine> lines = [];
    private long cursor;
    private bool gapped;

    private string? sendError;
    private bool shouldScroll;

    private ConsoleView view = ConsoleView.Console;
    private CompletionView? completion;
    private CompletionPlayers? players;
    private string filter = string.Empty;
    private bool playersDue;
    private int polls;

    private DotNetObjectReference<ConsoleTab>? self;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    private bool Visible(ConsoleLine line) => Filters.Shows(line);

    // The save query file lists (ON5) and boxed notices (ON2) clicked open: a file list
    // by its own line's sequence, a notice by its opening line's.
    private readonly HashSet<long> openedManifests = [];

    private void ToggleManifest(long sequence)
    {
        if (!openedManifests.Remove(sequence))
        {
            openedManifests.Add(sequence);
        }
    }

    // Read from the browser on the first render; until then every notice keeps its default.
    private ConsoleNoticeChoices noticeChoices = new();

    private async Task ToggleNotice(string banner, bool shown)
    {
        noticeChoices.Choose(banner, shown);
        try
        {
            await JS.InvokeVoidAsync("bedrockSentryConsole.saveNoticeChoices", Supervisor.InstanceId.ToString(), noticeChoices.Serialize());
        }
        catch (JSException)
        {
            // Storage refused (a private window, blocked site data): the choice holds for this page.
        }
    }

    private static bool Ticked(ChangeEventArgs e) => e.Value is bool value && value;

    private async Task SetAsync(ConsoleFilters wanted)
    {
        Filters = wanted;
        await FiltersChanged.InvokeAsync(wanted);

        // Unhiding adds lines below the last one visible, so follow them the way
        // any other new output is followed.
        shouldScroll = true;
    }

    private bool CanSend =>
        Supervisor.Status.State is InstanceState.Running or InstanceState.Starting;

    // The commands the server has, aliases left out, as the script counts them.
    private int CommandCount =>
        completion is { } data ? data.Commands.Grammar.Commands.Count + data.AddonCommands.Count : 0;

    protected override void OnInitialized()
    {
        Pump();
        completion = Completion.For(Supervisor);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            cts = new CancellationTokenSource();

            // Twice a second: fast enough that typing a command and seeing the
            // reply feels immediate, slow enough that a chatty server does not
            // render on every line.
            timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            _ = PollAsync(cts.Token);

            // Starts the console at the bottom and begins watching the operator's
            // own scrolling, which is the only reliable source of "do they want
            // to follow this". Asking after new output has landed cannot answer
            // it — the view is by then exactly as far from the bottom as the new
            // batch is tall.
            await JS.InvokeVoidAsync("bedrockSentryConsole.attach", "console-output");
            noticeChoices = ConsoleNoticeChoices.Parse(
                await JS.InvokeAsync<string?>("bedrockSentryConsole.noticeChoices", Supervisor.InstanceId.ToString()));

            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "bedrockSentryCompletion.attach",
                new
                {
                    input = InputId,
                    list = ListId,
                    usage = UsageId,
                    ghost = GhostId,
                    ghostTyped = GhostTypedId,
                    ghostRest = GhostRestId,
                    send = SendId,
                },
                CompletionPayload.PathFor(Supervisor.InstanceId),
                self);
            await PushPlayersAsync(CancellationToken.None);
        }

        if (shouldScroll)
        {
            shouldScroll = false;
            await JS.InvokeVoidAsync("bedrockSentryConsole.follow", "console-output");
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(cancellationToken))
            {
                Pump();
                if (playersDue || ++polls >= PlayersEveryPolls)
                {
                    await InvokeAsync(() => PushPlayersAsync(cancellationToken));
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away or losing the circuit.
        }
        catch (JSDisconnectedException)
        {
            // The circuit went while a push was on its way.
        }
    }

    // The names completion offers, and the data's tag, which tells the script to fetch
    // the data again when it has changed: a version read, Mojang's data fetched, an
    // add-on switched on.
    private async Task PushPlayersAsync(CancellationToken cancellationToken)
    {
        playersDue = false;
        polls = 0;
        completion = Completion.For(Supervisor);
        players = await CompletionPlayers.ReadAsync(Players, Supervisor, Time.GetUtcNow(), cancellationToken);

        try
        {
            await JS.InvokeVoidAsync(
                "bedrockSentryCompletion.update",
                cancellationToken,
                InputId,
                new { online = players.Online, known = players.Known, allowlist = players.Allowlist },
                completion.Tag);
        }
        catch (JSException)
        {
            // Names are a convenience. A script error here must not end the poll that
            // keeps the output moving; the next push tries again.
        }
    }

    private void Pump()
    {
        var snapshot = Supervisor.Console.Read(cursor);
        cursor = snapshot.Cursor;

        if (snapshot.Gap)
        {
            gapped = true;
        }

        if (snapshot.Lines.Count == 0)
        {
            return;
        }

        lines.AddRange(snapshot.Lines);
        if (lines.Count > MaxRenderedLines)
        {
            lines.RemoveRange(0, lines.Count - MaxRenderedLines);
            openedManifests.RemoveWhere(sequence => sequence < lines[0].Sequence);
        }

        // Somebody arrived or left, so the online names have changed.
        if (snapshot.Lines.Any(l => l.Kind is ConsoleLineKind.PlayerJoined or ConsoleLineKind.PlayerLeft))
        {
            playersDue = true;
        }

        shouldScroll = true;
    }

    private async Task ShowAsync(ConsoleView wanted)
    {
        view = wanted;
        if (wanted == ConsoleView.Commands)
        {
            completion = Completion.For(Supervisor);
            players = await CompletionPlayers.ReadAsync(Players, Supervisor, Time.GetUtcNow());
        }
        else
        {
            // Back from the Commands view, the output has grown underneath it.
            shouldScroll = true;
        }
    }

    /// <summary>Sends what the input held; the script calls it on Enter or Send.</summary>
    [JSInvokable]
    public async Task SendFromBrowser(string text)
    {
        text = text?.Trim() ?? string.Empty;
        if (text.Length == 0 || !CanSend)
        {
            return;
        }

        try
        {
            await Supervisor.SendCommandAsync(text);
            sendError = null;
        }
        catch (Exception ex)
        {
            sendError = $"Could not send that command: {ex.Message}";
        }

        Pump();
        StateHasChanged();
    }

    private IEnumerable<SourceRow> SourceRows(CompletionView data)
    {
        static string At(DateTimeOffset utc) => "at " + ClockText.TimeOnDay(utc.ToLocalTime());

        yield return CompletionSources.Commands(data.Commands, At);
        yield return CompletionSources.Options(data.Commands);
        yield return CompletionSources.GameRules(data.Commands);
        yield return CompletionSources.Vanilla(data.VanillaSource, At);
        yield return CompletionSources.Players(players?.SeenNotListed ?? 0, players?.Allowlist?.Count);
        yield return CompletionSources.Addons(data.Addons, At);
    }

    // The server's commands, then the add-ons', each with the add-on it came from, through
    // the filter Core states.
    private IEnumerable<(GrammarCommand Command, string? Addon)> Reference(CompletionView data)
    {
        var addon = data.Addons.Packs.Count > 0 ? string.Join(", ", data.Addons.Packs) : "an add-on";
        return data.Commands.Grammar.Commands.Select(c => (c, (string?)null))
            .Concat(data.AddonCommands.Select(c => (c, (string?)addon)))
            .Where(r => CommandReference.Matches(r.Item1, filter, r.Item2));
    }

    private string ReferenceCount(CompletionView data)
    {
        var shown = Reference(data).Count();
        var all = CommandCount;
        return shown == all ? $"{all} commands" : $"{shown} of {all} commands";
    }

    public async ValueTask DisposeAsync()
    {
        // Without this the poll loop outlives the component and calls
        // StateHasChanged on a disposed renderer — one leaked timer per tab switch.
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }

        timer?.Dispose();

        // Only once attached: a prerendered copy is disposed without ever having a
        // circuit, and a JS call from it throws InvalidOperationException (T396).
        if (self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("bedrockSentryCompletion.dispose", InputId);
            }
            catch (JSDisconnectedException)
            {
                // The page is gone, and its listeners with it.
            }

            self.Dispose();
        }
    }
}
