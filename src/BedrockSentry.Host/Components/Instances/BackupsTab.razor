    /// </summary>
    /// <remarks>
    /// <para>The two halves come from different places on purpose. What is
    /// restorable is read off the disk, because a restore puts back a
    /// <em>file</em>; whether backups are working is read from the history,
    /// because a file cannot say why the run after it failed. Deriving either
    /// from the other is what lets a green history render over an empty
    /// folder.</para>
    ///
    /// <para>The newest date is <c>BackupStanding.NewestTaken</c>'s: the newest
    /// file this server took, leaving imports out, in any order the picker hands
    /// it. <c>BackupStandingTests</c> pins the arms.</para>
    /// </remarks>
    private BackupStanding Standing => BackupStanding.For(
        history,
        KeptOnDisk.Of(archives).Count,
        BackupStanding.NewestTaken(archives.Select(a => (a.FullName, a.TakenUtc)), history),
        KeptOnDisk.Of(archives).Bytes);

    /// The note travels with the history record, not the file — find the record
    /// whose zip this is. A hand-placed archive simply has none.
    /// <remarks>
    /// Two passes on purpose (`T124`). History stores an absolute
    /// <c>ArtifactPath</c>, so moving a backup folder to another volume — which
    /// `T96` tells an operator to do — leaves every stored path pointing at
    /// where the archive used to be, and an exact match then finds nothing.
    /// The second pass matches on file name instead, which is safe here because
    /// both sides are already scoped to this one instance and the names are
    /// stamped to the second. Exact match still goes first, so a name collision
    /// between two folders cannot beat a path that genuinely matches.
    /// </remarks>
    // ---- D68: per-artifact notes and locks --------------------------------

    private IReadOnlyDictionary<string, BackupArtifactState> artifactStates =
        new Dictionary<string, BackupArtifactState>(StringComparer.OrdinalIgnoreCase);

    private string? editingNoteFor;
    private string noteDraft = string.Empty;
    private bool savingNote;

    private BackupArtifactState StateOf(string name) =>
        artifactStates.TryGetValue(name, out var state) ? state : new BackupArtifactState();

    private void BeginNote(string name)
    {
        editingNoteFor = name;
        noteDraft = StateOf(name).Note ?? string.Empty;
    }

    private async Task SaveNoteAsync(string name)
    {
        savingNote = true;

        try
        {
            await Artifacts.SetAsync(
                Supervisor.InstanceId, name, StateOf(name) with { Note = noteDraft });

            artifactStates = await Artifacts.ReadAsync(Supervisor.InstanceId);
            editingNoteFor = null;
        }
        finally
        {
            savingNote = false;
        }
    }

    /// A lock is one click and no confirmation, both ways. It is reversible, it
    /// destroys nothing, and the only thing it changes is whether retention may
    /// reach this artifact — so a dialog here would be friction against the safe
    /// direction.
    private async Task ToggleLockAsync(string name)
    {
        savingNote = true;

        try
        {
            var state = StateOf(name);
            await Artifacts.SetAsync(
                Supervisor.InstanceId, name, state with { Locked = !state.Locked });

            artifactStates = await Artifacts.ReadAsync(Supervisor.InstanceId);
        }
        finally
        {
            savingNote = false;
        }
    }

    private string? NoteFor(string archivePath)
    {
        var candidates = history
            .SelectMany(r => r.Strategies
                .Where(s => !string.IsNullOrEmpty(s.ArtifactPath))
                .Select(s => (r.Note, Recorded: s.ArtifactPath!)))
            .ToList();

        var exact = candidates.FirstOrDefault(x =>
            string.Equals(x.Recorded, archivePath, StringComparison.OrdinalIgnoreCase));

        if (exact.Recorded is not null)
        {
            return exact.Note;
        }

        var name = Path.GetFileName(archivePath);

        return candidates
            .FirstOrDefault(x => string.Equals(
                Path.GetFileName(x.Recorded), name, StringComparison.OrdinalIgnoreCase))
            .Note;
    }

    private void BeginRestore(string archivePath)
    {
        copyCandidate = null;
        ClearStage();
        restoreCandidate = archivePath;
        restorePassword = string.Empty;
        restoreError = null;
        restoreConfig = false;
        restoreAddons = true;
        areaCandidate = null;
        areaElsewhere = null;
        candidateContents = Restorer.ReadContents(archivePath);
        safetyNeed = Restorer.NeedFor(Supervisor, restoreConfig);
        restoreLink = Restorer.LinkRefusal(Supervisor);
        scrollTo = ".backups-panels";
    }

    /// <summary>
    /// Ticking the configuration box can turn a restore that needs no undo into one
    /// that cannot have one (`T168`), so the promise is re-asked rather than written
    /// once when the dialog opens.
    /// </summary>
    private void ConfigBoxChanged(ChangeEventArgs e)
    {
        restoreConfig = (bool?)e.Value == true;
        safetyNeed = Restorer.NeedFor(Supervisor, restoreConfig);
    }

    /// <summary>
    /// Opens the copy dialog for one backup, and works out which build it offers.
    /// </summary>
    /// <remarks>
    /// The build question is asked per backup rather than per instance, because its
    /// answer depends on when THIS backup was taken: the same instance and the same
    /// version log give a different state for an archive from before its last
    /// Bedrock update and one from after (`D41`).
    /// </remarks>
    private void BeginCopy(RestorableBackup backup)
    {
        restoreCandidate = null;
        areaCandidate = null;
        areaElsewhere = null;
        scrollTo = ".backups-panels";
        ClearStage();
        copyCandidate = backup.FullName;
        copyError = null;
        copySummary = null;
        copyConfig = false;
        copyAddons = true;
        copyFolder = string.Empty;
        copyName = $"{Supervisor.Definition.Name} copy";
        copyPort = Ports.SuggestPort();
        copyContents = Restorer.ReadContents(backup.FullName);
        packages = Packages.List();

        var recorded = Versions.Read(Supervisor.InstanceId);

        copyChoice = RestoreBuildChoice.For(
            packages,
            recorded is null
                ? null
                : new RecordedBuild(recorded.Version, recorded.IsAnUpdate, recorded.FirstSeenUtc),
            backup.TakenUtc,
            copyContents.BdsVersion);

        copyPackage = copyChoice.Preselected ?? string.Empty;
    }

    private void CancelCopy()
    {
        copyCandidate = null;
        copyError = null;
    }

    private async Task ConfirmCopyAsync()
    {
        if (copying || copyCandidate is null || !CopyIsPossible)
        {
            return;
        }

        copying = true;
        copyError = null;

        try
        {
            var result = await Copier.RestoreAsync(Supervisor, new RestoreAsNewRequest(
                copyCandidate,
                copyName.Trim(),
                copyPackage!,
                copyPort,
                string.IsNullOrWhiteSpace(copyFolder) ? null : copyFolder.Trim(),
                copyConfig,
                copyAddons));

            // One statement of the sentence, in Services where a test can reach it.
            // It is shown whether or not the world went in, because by the time it
            // could fail the server exists and saying nothing about it would be the
            // worse of the two failures (`T229`).
            copySummary = result.Summary();
            copyCandidate = null;
        }
        catch (Exception ex)
        {
            copyError = ex.Message;
        }
        finally
        {
            copying = false;
        }
    }

    /// <summary>
    /// Whether the copy button can act — asked by the attribute and the handler
    /// both, because a disabled button is a hint and the handler is the rule.
    /// </summary>
    private bool CopyIsPossible =>
        copyContents.CanRestore
        && copyChoice.CanCreate
        && !string.IsNullOrWhiteSpace(copyName)
        && !string.IsNullOrEmpty(copyPackage);

    /// <summary>Confirming a restore, or one running in the background (`D111`).</summary>
    private bool RestoreBusy => restoring || Restores.IsRunning(Supervisor.InstanceId);

    /// <summary>What the next render scrolls to: the panels when one opens, the controls when a restore starts.</summary>
    private string? scrollTo;

    // `D108`: one area restored from one backup.
    private RestorableBackup? areaCandidate;

    // `D111`: the server the area goes onto, this one unless another is chosen.
    private string areaTargetId = string.Empty;

    /// <summary>Said here when the area went onto another server, whose own page shows its steps.</summary>
    private string? areaElsewhere;

    /// <summary>The other servers an area can go onto, by name.</summary>
    private IEnumerable<InstanceSupervisor> AreaTargets => Registry.All
        .Where(s => s.InstanceId != Supervisor.InstanceId && !s.Definition.Retired)
        .OrderBy(s => s.Definition.Name, StringComparer.CurrentCultureIgnoreCase);

    private string AreaTargetName =>
        Registry.TryGet(areaTargetId, out var target) ? target.Definition.Name : Supervisor.Definition.Name;

    private AreaRestoreTarget areaTarget = AreaRestoreTarget.Named(string.Empty);
    private string? areaError;
    private bool areaStarting;

    private AreaRestorePlan AreaPlan => AreaRestorePlan.For(areaTarget, Supervisor.Definition.Sync.KeptAreas);

    /// <summary>Asked by the button and the handler both: a disabled button is a hint, the handler the rule.</summary>
    /// <remarks>
    /// No password, as the operator chose on 2026-10-09: a restore of one area takes a safety
    /// backup of the whole world first, and <c>restorearea</c> in game asks for none either.
    /// </remarks>
    private bool AreaRestoreIsPossible => AreaPlan.CanRestore;

    private void BeginAreaRestore(RestorableBackup backup)
    {
        restoreCandidate = null;
        copyCandidate = null;
        ClearStage();
        areaCandidate = backup;
        areaTargetId = Supervisor.InstanceId;
        areaElsewhere = null;
        scrollTo = ".backups-panels";
        areaError = null;
    }

    private void CancelAreaRestore()
    {
        areaCandidate = null;
        areaError = null;
    }

    private async Task ConfirmAreaRestoreAsync()
    {
        if (areaStarting || areaCandidate is null || !AreaRestoreIsPossible)
        {
            return;
        }

        areaStarting = true;
        areaError = null;

        try
        {
            var target = Registry.TryGet(areaTargetId, out var chosen) ? chosen : Supervisor;

            await AreaRestores.StartAsync(target.InstanceId, areaTarget, areaCandidate.Name, from: Supervisor.InstanceId);

            areaElsewhere = target == Supervisor
                ? null
                : AreaRestoreText.RunsElsewhere(target.Definition.Name);
            areaCandidate = null;
        }
        catch (InvalidOperationException ex)
        {
            areaError = ex.Message;
        }
        finally
        {
            areaStarting = false;
        }
    }

    private void CancelRestore()
    {
        restoreCandidate = null;
        restorePassword = string.Empty;
        restoreError = null;
        restoreConfig = false;
        restoreAddons = true;
    }

    /// <summary>
    /// Checks the password, then starts the restore in the background and closes the panel:
    /// its steps and how it ended show in the strip under the server's controls (`D111`).
    /// </summary>
    private async Task ConfirmRestoreAsync()
    {
        if (restoring || restoreCandidate is null || !RestoreIsPossible)
        {
            return;
        }

        restoring = true;
        restoreError = null;

        try
        {
            if (await RefusalAsync(restorePassword) is { } refusal)
            {
                restoreError = refusal;
                return;
            }

            Restores.Start(Supervisor, restoreCandidate, restoreConfig, restoreAddons);
            restoreCandidate = null;
            scrollTo = ".instance-bar";
        }
        catch (InvalidOperationException ex)
        {
            restoreError = ex.Message;
        }
        finally
        {
            restoring = false;
            restorePassword = string.Empty;
        }
    }

    /// <summary>
    /// Whether the restore button can act — asked by both the attribute and the
    /// handler, because a disabled button is a hint and the handler is the rule.
    /// </summary>
    // And a restore that cannot take a safety backup for what it would overwrite is
    // refused here as well as in the restorer (`T168`). Both, deliberately: the
    // button is where somebody finds out before committing, and the restorer is what
    // makes it true for any caller, including an HTTP POST that never saw this page.
    private bool RestoreIsPossible =>
        !Restores.IsRunning(Supervisor.InstanceId)
        && candidateContents.CanRestore
        && !SafetyBackupRule.Refuses(safetyNeed)
        && restoreLink is null
        && Confirm.MayConfirm(restorePassword);

    /// <remarks>
    /// Shared with the Remove and Retire dialogs through
    /// <c>DestructiveConfirmPolicy</c>; this page used to carry its own copy of both the
    /// button predicate and the early return.
    /// </remarks>
    private async Task<string?> RefusalAsync(string typed)
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;

        return await Confirm.RefusalAsync(state?.User.Identity?.Name, typed);
    }

    /// <summary>Which controls one artifact's cell is showing.</summary>
    /// <remarks>
    /// Compared on the full path rather than the name: a run with both formats on
    /// writes two artifacts whose names differ only by extension, and both are rows
    /// in the same table.
    /// </remarks>
    private BackupRowStage StageOf(RestorableBackup artifact) =>
        stagedBackup is not null
        && string.Equals(stagedBackup.FullName, artifact.FullName, StringComparison.OrdinalIgnoreCase)
            ? stagedAs
            : BackupRowStage.Actions;

    /// <remarks>
    /// Staging closes the two panels, the way opening either of them used to close
    /// the other: a panel describing one archive under a row asking about another is
    /// two answers to one question.
    /// </remarks>
    private void Stage(RestorableBackup archive, BackupRowStage stage)
    {
        restoreCandidate = null;
        copyCandidate = null;
        stagedBackup = archive;
        stagedAs = stage;
        deleteSummary = null;
    }

    private void StageDelete(RestorableBackup archive) => Stage(archive, BackupRowStage.ConfirmDelete);

    private void StageRestore(RestorableBackup archive) => Stage(archive, BackupRowStage.ChooseRestore);

    private void StageDownload(RestorableBackup archive) => Stage(archive, BackupRowStage.ChooseDownload);

    // ---- `D110`: import one backup ---------------------------------------------

    private bool importOpen;
    private bool importFromFolder;
    private bool importing;
    private bool uploading;
    private string? importFolder;
    private string? importNote;
    private string? importUpload;
    private string? importError;
    private string? importSummary;
    private BackupImportPreview? importPreview;
    private int importPickerKey;
    private string? uploadName;
    private long uploadSize;
    private long uploaded;
    private CancellationTokenSource? uploadStop;

    private int UploadPercent => uploadSize <= 0 ? 0 : (int)(uploaded * 100 / uploadSize);

    private void ToggleImport()
    {
        if (importOpen)
        {
            CloseImport();
            return;
        }

        importOpen = true;
        importSummary = null;
    }

    private void ChooseImportSource(bool folder)
    {
        DiscardImportUpload();
        importFromFolder = folder;
    }

    private void CloseImport()
    {
        DiscardImportUpload();
        importOpen = false;
        importFolder = null;
        importNote = null;
    }

    /// <param name="clearPicker">
    /// Also empty the file picker. Not when a new file was just chosen in it: it would read
    /// "No file chosen" beside that file's summary.
    /// </param>
    private void DiscardImportUpload(bool clearPicker = true)
    {
        Uploads.Discard(importUpload);
        importUpload = null;
        importPreview = null;
        importError = null;

        if (clearPicker)
        {
            importPickerKey++;
        }
    }

    private void CheckFolder()
    {
        importError = null;
        importPreview = string.IsNullOrWhiteSpace(importFolder) ? null : Importer.ReadFolder(importFolder.Trim());
    }

    private async Task UploadImportAsync(InputFileChangeEventArgs args)
    {
        DiscardImportUpload(clearPicker: false);

        var file = args.File;

        if (file.Size > WorldFileImport.MaxUploadBytes)
        {
            importError = $"{file.Name} is larger than {ByteSize.Format(WorldFileImport.MaxUploadBytes)}, "
                + "the most a backup may be.";
            return;
        }

        uploading = true;
        uploadName = file.Name;
        uploadSize = file.Size;
        uploaded = 0;
        uploadStop = new CancellationTokenSource();

        // A render per percent rather than per megabyte, which on a large world is
        // thousands of renders over the circuit.
        var progress = new Progress<long>(bytes =>
        {
            var before = UploadPercent;
            uploaded = bytes;

            if (UploadPercent != before)
            {
                StateHasChanged();
            }
        });

        try
        {
            await using var stream = file.OpenReadStream(WorldFileImport.MaxUploadBytes, uploadStop.Token);
            importUpload = await Uploads.SaveUploadAsync(stream, progress, uploadStop.Token);
            importPreview = Importer.ReadUpload(importUpload, file.Name);
            importUploadName = file.Name;

            if (!importPreview.CanImport)
            {
                // Nothing can be made of it, so it is not kept; the refusal stays shown.
                Uploads.Discard(importUpload);
                importUpload = null;
                importPickerKey++;
            }
        }
        catch (OperationCanceledException)
        {
            importError = $"The upload of {file.Name} was stopped.";
            importPickerKey++;
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            importError = $"{file.Name} could not be uploaded: {ex.Message}";
            importPickerKey++;
        }
        finally
        {
            uploading = false;
            uploadStop.Dispose();
            uploadStop = null;
        }
    }

    private string? importUploadName;

    private async Task ImportAsync()
    {
        if (importing || importPreview is not { CanImport: true })
        {
            return;
        }

        importing = true;
        importError = null;

        try
        {
            var result = importFromFolder
                ? await Importer.ImportFolderAsync(Supervisor.InstanceId, importFolder!.Trim(), importNote)
                : await Importer.ImportUploadAsync(
                    Supervisor.InstanceId, importUpload!, importUploadName!, importNote);

            // The upload is consumed by the import.
            importUpload = null;
            importSummary = result.Summary();
            CloseImport();
            filter = BackupTimelineFilter.Restorable;
            await LoadHistoryAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException
                                       or InvalidDataException)
        {
            importError = ex.Message;
        }
        finally
        {
            importing = false;
        }
    }

    private void ClearStage()
    {
        stagedBackup = null;
        stagedAs = BackupRowStage.Actions;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleting || stagedBackup is null || stagedAs != BackupRowStage.ConfirmDelete)
        {
            return;
        }

        deleting = true;

        try
        {
            var outcome = await Deleter.DeleteAsync(Supervisor.InstanceId, stagedBackup);

            // One statement of the sentence, composed in `Core` where a test can
            // reach it. Four outcomes, and the two that are not good news are told
            // apart here rather than all four reading as a completed delete.
            deleteSummary = outcome.Summary();
            deleteSummaryNeedsAttention = outcome.NeedsAttention;
        }
        catch (Exception ex)
        {
            // Into the same line, in the same style as a refusal. A second field for
            // a thrown failure would be a fourth place this page says a delete did
            // not happen, and the reader wants one.
            deleteSummary = ex.Message;
            deleteSummaryNeedsAttention = true;
        }
        finally
        {
            deleting = false;
            ClearStage();

            // Always, including after a failure: a part-deleted folder has to leave
            // the restore picker, and the picker is rebuilt from disk here.
            await LoadHistoryAsync();
        }
    }

    private async Task RunNowAsync()
    {
        if (running)
        {
            return;
        }

        running = true;
        runError = null;

        try
        {
            var trimmed = note.Trim();
            await Orchestrator.RunAsync(
                Supervisor,
                new BackupRequest(BackupReason.Manual, trimmed.Length == 0 ? null : trimmed));

            note = string.Empty;
        }
        catch (Exception ex)
        {
            runError = ex.Message;
        }
        finally
        {
            running = false;
            await LoadHistoryAsync();
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        savedFlash = false;
        saveError = null;

        try
        {
            // The same object Dirty compared against, so what was saved and what
            // counted as a change can never be two different lists of fields.
            var saved = Edited();
            await Registry.SetBackupSettingsAsync(Supervisor.InstanceId, saved);

            // T216. The stored values are seeded once per instance id and were
            // never re-read, so a SECOND save in one page visit passed the
            // page-load number back to AsSaved and reverted whatever the first
            // save had written. D76 taught the form to write what it shows; what
            // it shows for a value it is not rendering is whatever it was last
            // told, and nothing was re-telling it.
            //
            // From the object that was saved rather than from the fields, so the
            // two cannot describe different saves.
            storedZipRetentionValue = saved.Zip.Retention.Value;
            storedFolderRetentionValue = saved.Folder.Retention.Value;

            savedFlash = true;
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    // T158. One place decides what a record reads as, because there were two —
    // this page and the all-instances Backups page each had their own
    // Skipped / Succeeded / else ladder, and neither can be reached by the test
    // suite. The words and the severity come from BackupRecord.Outcome(); this
    // only maps severity to the stylesheet's class.
    private static string Took(BackupRecord record)
    {
        var span = record.Duration;
        if (span < TimeSpan.FromSeconds(1)) { return "<1s"; }
        if (span < TimeSpan.FromMinutes(1)) { return $"{span.TotalSeconds:0}s"; }
        return $"{(int)span.TotalMinutes}m {span.Seconds}s";
    }
}

