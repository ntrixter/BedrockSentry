    private BackupTimelineFilter filter = BackupTimelineFilter.Restorable;

    /// <summary>Which of the tab's two views is showing.</summary>
    /// <remarks>
    /// The working view is the default because it is why somebody opens this
    /// tab: what has been backed up and how to put one back. Settings are
    /// changed once and then left, and they were what a reader had to scroll
    /// past to reach the history.
    /// </remarks>
    private enum BackupsView
    {
        Working,
        Settings,
    }

    private BackupsView view = BackupsView.Working;

    /// <summary>
    /// Where this server stands: whether anything can be put back, and whether
