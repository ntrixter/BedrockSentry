    /// scheduler's own rule, so the two cannot come to disagree about the moment
    /// this renders (`T248`).
    /// </remarks>
    private NextBackup NextDue =>
        NextBackup.For(Supervisor.Definition.Backup, scheduleAnchor, DateTimeOffset.UtcNow);

    /// <summary>Which rows of the timeline the chips are asking for.</summary>
