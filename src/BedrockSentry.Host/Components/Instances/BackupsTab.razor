            Enabled = zipEnabled,
            Compression = compression,

            // Through Core rather than composed here, so the two formats cannot
            // drift and the rule is somewhere a test can reach it (`D76`).
            Retention = BackupRetentionPlan.AsSaved(
                retentionMode, retentionValue, storedZipRetentionValue),
        },
        Folder = new()
        {
            Enabled = folderEnabled,
            Retention = BackupRetentionPlan.AsSaved(
                folderRetentionMode, folderRetentionValue, storedFolderRetentionValue),
        },
        Acquisition = new()
        {
            UseShadowCopy = useShadowCopy,
        },
        CustomCommand = new()
