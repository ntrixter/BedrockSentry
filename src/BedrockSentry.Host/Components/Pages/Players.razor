@page "/players"
@* Interactive: the roster polls, and the export/import panel acts. *@
@rendermode InteractiveServer

@using BedrockSentry.Host.Components.Players

<PageTitle>Players · BedrockSentry</PageTitle>

<h1>Players</h1>

<p class="lead">
    Everyone who has ever played, across every instance — including retired ones.
</p>

<PlayerRoster @key="rosterGeneration" />

<PlayerArchivePanel OnImported="() => rosterGeneration++" />

<div class="empty-state">
    <p style="margin-top:0"><strong>Why somebody might be missing</strong></p>
    <p style="margin-bottom:0">
        Sessions only started being recorded in the build that introduced them, so
        anyone who played before it will not appear here until they next connect —
        the history is starting from then rather than missing.
    </p>
</div>

@code {
    // Bumped after an import so the roster is rebuilt rather than left showing
    // what it read before the file landed.
    private int rosterGeneration;
}

<p>
    Playtime <em>on one server</em>, and its allowlist and operator lists, live on
    that instance's own Players tab — Bedrock keeps <code>allowlist.json</code> and
    <code>permissions.json</code> inside each server's folder, so those cannot be
    global even in principle.
</p>
