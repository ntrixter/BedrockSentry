@* Where the space-hungry folders live (docs/design.md § 4.3). Only the directories
   that grow without bound are movable — backups, downloaded server packages,
   and where new instances land. Everything else the wrapper keeps is small and
   stays at the data root, whose location cannot be a setting inside itself. *@

@using BedrockSentry.Core.Diagnostics
@using BedrockSentry.Core.Instances
@using BedrockSentry.Services.Configuration
@using BedrockSentry.Services.Instances

@inject StorageLocations Storage
@inject InstanceRegistry Registry
@inject OrphanedStorage LeftBehind

<h2>Storage</h2>

<p class="lead">
    The three folders that grow over time, each placeable on whichever volume has
    the room. Changes apply immediately, with no restart — but nothing is moved
    for you: files already at an old location stay there, and stop being listed
    until you move them across yourself. Any quiet moment will do; the wrapper
    holds none of these folders open between operations.
</p>

<div class="prop-panel">
    <div class="prop">
        <div class="prop-edit">
            <div class="settings-row">
                <label class="field">
                    <span>Backups</span>
                    <input class="form-control" @bind="backupsRoot" @bind:after="OnBackupsRootChangedAsync"
                           disabled="@busy" placeholder="@Storage.DefaultBackupsRoot" />
                </label>
            </div>
            @Feedback("backups")
        </div>
        <div class="prop-doc">
            <p>
                ZIP archives, snapshot folders and each server's backup history. The
                biggest consumer of disk over time, and the one most worth putting on a
                large volume.
            </p>
            <span class="prop-allowed">
                New backups land here at once. Old ones stay where they were taken and
                leave the restore picker until moved — move the per-server folders across
                and they come straight back, history and all. Blank returns to the
                default.
            </span>
        </div>
    </div>

    <div class="prop">
        <div class="prop-edit">
            <div class="settings-row">
                <label class="field">
                    <span>Server packages</span>
                    <input class="form-control" @bind="packagesRoot" @bind:after="OnPackagesRootChangedAsync"
                           disabled="@busy" placeholder="@Storage.DefaultServerPackagesRoot" />
                </label>
            </div>
            @Feedback("packages")
        </div>
        <div class="prop-doc">
            <p>
                Every downloaded Bedrock zip — a few hundred megabytes each, and they
                accumulate with every update the wrapper fetches.
            </p>
            <span class="prop-allowed">
                Downloads land here at once; zips at the old location leave the build
                lists until moved. Blank returns to the default.
            </span>
        </div>
    </div>

    <div class="prop">
        <div class="prop-edit">
            <div class="settings-row">
                <label class="field">
                    <span>New servers</span>
                    <input class="form-control" @bind="instancesRoot" @bind:after="OnInstancesRootChangedAsync"
                           disabled="@busy" />
                </label>
            </div>
            @Feedback("instances")
        </div>
        <div class="prop-doc">
            <p>
                Where a newly created server's folder is placed — worlds are the other
                thing that grows.
            </p>
            <span class="prop-allowed">
                Existing servers never move from here: each is pinned to its current
                folder before this changes, so nothing is re-addressed behind its back.
                A single server is moved from its own Configuration tab, and can be
                given its own folder when it is created.
            </span>
        </div>
    </div>
</div>

@* D63, answered by the operator 2026-09-25. What removed servers left behind was
   invisible: nothing listed it, the folders sit under a data root an ordinary account
   cannot open, and no tab exists for a server that is gone. Listed here with a tickbox
   each; nothing goes unless it is ticked and the deletion confirmed, and nothing is
   pruned by age, which is what D39 keeps a removed server's backups for. *@
<h3>Left behind by removed servers</h3>

<p class="check-detail">
    Folders and files a server left when it was removed: its backups when the box to delete
    them was left unticked, its console logs, and its record of the Bedrock build it ran. No
    server uses them. Copy out any backup you want before deleting it.
</p>

@if (orphans.Unreadable is { } unreadable)
{
    <p class="console-fault">@unreadable</p>
}

@if (orphans.Items.Count == 0)
{
    <p class="empty-state">Nothing is left behind.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 2.5rem">
                        <input type="checkbox" aria-label="Select everything left behind"
                               checked="@(selected.Count == orphans.Items.Count)"
                               disabled="@deleting"
                               @onchange="e => SelectAll((bool?)e.Value == true)" />
                    </th>
                    <th>What</th>
                    <th>Server</th>
                    <th class="num">Size</th>
                    <th>Last changed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in orphans.Items)
                {
                    var changed = item.LastChangedUtc.ToLocalTime();

                    <tr>
                        <td>
                            <input type="checkbox" aria-label="@($"Select {OrphanedStorageRules.Describe(item.Kind)} of {item.Name}")"
                                   checked="@selected.Contains(item.Key)"
                                   disabled="@deleting"
                                   @onchange="e => Toggle(item.Key, (bool?)e.Value == true)" />
                        </td>
                        <td>@OrphanedStorageRules.Describe(item.Kind)</td>
                        <td>
                            <code>@item.Name</code>
                            <div class="check-detail">@item.Files file@(item.Files == 1 ? "" : "s")</div>
                        </td>
                        <td class="num">@ByteSize.Format(item.SizeBytes)</td>
                        <td>
                            @ClockText.Time(changed)
                            <span class="check-detail" style="display:block">@ClockText.Day(changed)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="provision-controls">
        @if (confirmingDelete)
        {
            <span class="check-detail">
                Delete @selected.Count item@(selected.Count == 1 ? "" : "s")? This cannot be undone.
            </span>
            <button class="btn btn-danger" disabled="@deleting" @onclick="DeleteSelected">
                @(deleting ? "Deleting…" : "Delete")
            </button>
            <button class="btn btn-secondary" disabled="@deleting" @onclick="() => confirmingDelete = false">
                Cancel
            </button>
        }
        else
        {
            <button class="btn btn-secondary" disabled="@(selected.Count == 0)"
                    @onclick="() => confirmingDelete = true">
                Delete selected@(selected.Count > 0 ? $" ({selected.Count})" : "")
            </button>
        }
    </div>
}

@if (deleteSummary is { } summary)
{
    <p class="@(deleteSummaryIsBad ? "prop-check bad" : "check-detail")">@summary</p>
}

@code {
    private OrphanListing orphans = new([], null);
    private readonly HashSet<string> selected = new(StringComparer.OrdinalIgnoreCase);
    private bool confirmingDelete;
    private bool deleting;
    private string? deleteSummary;
    private bool deleteSummaryIsBad;

    private void Toggle(string key, bool on)
    {
        if (on)
        {
            selected.Add(key);
        }
        else
        {
            selected.Remove(key);
        }

        confirmingDelete = false;
    }

    private void SelectAll(bool on)
    {
        selected.Clear();

        if (on)
        {
            selected.UnionWith(orphans.Items.Select(i => i.Key));
        }

        confirmingDelete = false;
    }

    /// <summary>
    /// Deletes what is ticked. The service asks the list again first, so an item a
    /// server has since taken back is left alone (<c>D63</c>).
    /// </summary>
    private void DeleteSelected()
    {
        deleting = true;

        try
        {
            var results = LeftBehind.Delete(selected.ToList());

            deleteSummary = OrphanedStorageRules.Summary(results);
            deleteSummaryIsBad = results.Any(r => r.Outcome != OrphanDeletionOutcome.Deleted);
        }
        finally
        {
            deleting = false;
            confirmingDelete = false;
            selected.Clear();
            orphans = LeftBehind.List();
        }
    }

    private string backupsRoot = string.Empty;
    private string packagesRoot = string.Empty;
    private string instancesRoot = string.Empty;
    private bool busy;
    private string? errorFor;
    private string? error;
    private string? savedFor;

    protected override void OnInitialized()
    {
        SyncFromSource();
        orphans = LeftBehind.List();
    }

    /// <summary>
    /// Overrides shown as themselves, the default shown as the placeholder — so
    /// a blank field honestly reads as "the default", and clearing a field is
    /// how you go back to it. Run after every save attempt, success or failure,
    /// so the field always ends up showing what is actually in force rather
    /// than what somebody typed.
    /// </summary>
    /// <remarks>
    /// This relies on <c>@@bind</c> rather than a plain <c>value</c> attribute:
    /// Blazor tracks the bound value with the special handling that forces a
    /// client-side sync on every render the binding participates in, even when
    /// the reverted string is identical to what the browser is already
    /// showing — a rejected edit's own text, for instance. A manual
    /// <c>value="@@field"</c> would diff against the last render and, finding no
    /// change, leave the rejected text on screen with no way to tell the
    /// config file no longer agrees with it.
    /// </remarks>
    private void SyncFromSource()
    {
        backupsRoot = Storage.BackupsRoot == Storage.DefaultBackupsRoot ? "" : Storage.BackupsRoot;
        packagesRoot = Storage.ServerPackagesRoot == Storage.DefaultServerPackagesRoot
            ? ""
            : Storage.ServerPackagesRoot;
        instancesRoot = Registry.Root;
    }

    private RenderFragment? Feedback(string field) => builder =>
    {
        if (errorFor == field && error is not null)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "prop-check bad");
            builder.AddContent(2, error);
            builder.CloseElement();
        }
        else if (savedFor == field)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "prop-check ok");
            builder.AddContent(2, "Saved — in effect now. Move any existing files across when convenient.");
            builder.CloseElement();
        }
    };

    private async Task SaveAsync(string field, Func<CancellationToken, Task> save)
    {
        busy = true;
        errorFor = null;
        error = null;
        savedFor = null;

        try
        {
            await save(CancellationToken.None);
            savedFor = field;
        }
        catch (Exception ex)
        {
            errorFor = field;
            error = ex.Message;
        }
        finally
        {
            // Whether it succeeded or not: reload from what is actually in
            // force, never leave a field showing what somebody typed.
            SyncFromSource();
            busy = false;
        }
    }

    private Task OnBackupsRootChangedAsync() =>
        SaveAsync("backups", ct => Storage.SetBackupsRootAsync(backupsRoot, ct));

    private Task OnPackagesRootChangedAsync() =>
        SaveAsync("packages", ct => Storage.SetServerPackagesRootAsync(packagesRoot, ct));

    private Task OnInstancesRootChangedAsync() =>
        SaveAsync("instances", ct => Registry.SetRootAsync(instancesRoot, ct));
}
