@* The machine, not the wrapper: what address to give people, whether the name
   they use still points here, and whether the disk or a pending reboot is about
   to end the party. *@
@implements IDisposable

@using BedrockSentry.Core.Configuration
@using BedrockSentry.Core.Diagnostics
@using BedrockSentry.Services.Diagnostics
@using BedrockSentry.Services.Instances
@using Microsoft.Extensions.Options

@inject HostInspector Host
@inject InstanceRegistry Registry
@inject IOptionsMonitor<HostDetailsOptions> Options
@inject TimeProvider Time

<h2>Host</h2>

<div class="status-grid">
    <div class="status-card">
        <h2>Network</h2>
        <dl>
            <dt>Hostname</dt>
            <dd>@(addresses?.HostName ?? "—")</dd>

            <dt>Local</dt>
            <dd>
                @if (addresses is { LocalAddresses.Count: > 0 })
                {
                    @string.Join(", ", addresses.LocalAddresses)
                }
                else
                {
                    <text>—</text>
                }
            </dd>

            <dt>Public</dt>
            <dd>
                @if (addresses?.PublicAddress is { } publicAddress)
                {
                    @publicAddress
                }
                else
                {
                    <span class="check-detail">@(addresses?.PublicAddressNote ?? "…")</span>
                }
            </dd>
        </dl>

        @* D20. Disclosed here as well as in settings: this is the one thing on
           the page that reached outside the machine to answer a question. *@
        <p class="check-detail">
            @(Options.CurrentValue.DiscoverPublicAddress
                ? $"The public address comes from {Options.CurrentValue.PublicAddressEndpoint}, asked at most every "
                  + $"{Options.CurrentValue.PublicAddressCacheFor.TotalMinutes:0} minutes."
                : "Public address lookup is off, so nothing here contacts the internet.")
        </p>
    </div>

    <div class="status-card">
        <h2>System</h2>
        <dl>
            <dt>Processors</dt>
            <dd>@(system?.ProcessorCount.ToString() ?? "—")</dd>

            <dt>Memory</dt>
            <dd>
                @(system is null
                    ? "—"
                    : $"{ByteSize.Format(system.TotalMemoryBytes - system.AvailableMemoryBytes)} of {ByteSize.Format(system.TotalMemoryBytes)} used")
            </dd>

            <dt>Uptime</dt>
            <dd>@(system is null ? "—" : UptimeFormatter.Format(system.Uptime))</dd>
        </dl>
    </div>

    <div class="status-card">
        @* Scheduled restarts are written in local time, so a machine set to UTC
           runs an 05:00 restart at midnight — otherwise discoverable only from
           player complaints. *@
        <h2>Clock</h2>
        <dl>
            <dt>Local time</dt>
            <dd>@(system is { } host ? ClockText.DateAndTimeWithSeconds(host.LocalTime) : "—")</dd>

            <dt>Time zone</dt>
            <dd>@(system?.TimeZone ?? "—")</dd>
        </dl>
        <p class="check-detail">Restart schedules are written in this time zone.</p>
    </div>
</div>

@* T188, D64: only what can restart the machine by itself raises this. The
   file-rename queue, which cannot, kept it on the page for days with nothing
   pending, and is not read. *@
@if (system is not null && RebootNotice.Headline(system.RebootReasons) is { } headline)
{
    <p class="prop-stale">
        <strong>@headline</strong>
        @RebootNotice.Consequence(system.RebootReasons)
        @string.Join("; ", system.RebootReasons).
    </p>
}

@if (system?.RebootUnreadable is { } unreadable)
{
    <p class="check-detail">@unreadable</p>
}

@if (domain is { } check)
{
    <h3>Domain</h3>
    <div class="prop-panel">
        <div class="prop">
            <div class="prop-edit">
                <div class="check-title">
                    <span class="check-state check-@DomainStateClass(check.Result)"></span>
                    @check.Domain
                </div>
                <div class="check-detail">
                    @(check.ResolvedAddresses.Count > 0
                        ? $"resolves to {string.Join(", ", check.ResolvedAddresses)}"
                        : "does not resolve")
                </div>
            </div>
            <div class="prop-doc">
                @if (check.Detail is { } detail)
                {
                    <p>@detail</p>
                }
                else
                {
                    <p>This name points at this machine.</p>
                }
            </div>
        </div>
    </div>
}

@* Null until the read after the first paint comes back; see OnAfterRenderAsync. *@
@if (volumes is null)
{
    <h3>Storage</h3>
    <p class="empty-state">Checking…</p>
}
else if (volumes.Count > 0)
{
    @* D55. The three dedup columns appear only when some volume has something
       to say: on a machine without the role every row would read "Not installed",
       and one sentence under the table says that better. The rule for which it
       is, and every word in the cells, is VolumeDeduplication in Core (T429). *@
    var showDeduplication = VolumeDeduplication.ColumnWorthShowing(volumes.Select(v => v.Deduplication));
    var now = Time.GetUtcNow();

    <h3>Storage</h3>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Volume</th>
                    <th>Drive</th>
                    <th>Free</th>
                    <th>Total</th>
                    <th>Used</th>
                    @if (showDeduplication)
                    {
                        <th>Dedup. Rate</th>
                        <th>Dedup. Savings</th>
                        <th>Last Optimization</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var volume in volumes)
                {
                    <tr>
                        <td><code>@volume.RootPath</code></td>
                        <td>@DriveMediaRules.Text(volume.Media)</td>
                        <td class="num @FreeClass(volume.FreeLevel)">@volume.FreeText</td>
                        <td class="num">@ByteSize.Format(volume.TotalBytes)</td>
                        <td class="num">@volume.UsedText</td>
                        @if (showDeduplication)
                        {
                            <td>@volume.Deduplication.RateText(volume.UsedBytes)</td>
                            <td class="num">@volume.Deduplication.SavingsText</td>
                            <td class="@(volume.Deduplication.NeedsAttention ? "check-bad" : null)">
                                @volume.Deduplication.LastOptimizationText(now)
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @foreach (var warning in volumes.Select(v => (v.FreeLevel, Text: v.FreeWarning)).Where(w => w.Text is not null))
    {
        <p class="@FreeClass(warning.FreeLevel)">@warning.Text</p>
    }
    <p class="check-detail">
        A backup schedule quietly filling a disk is the most common way an
        installation like this dies.
    </p>
    @if (showDeduplication)
    {
        <p class="check-detail">
            Deduplication runs as a scheduled job, not as files are written, so
            free space on an optimized volume rises on its own hours after a
            backup — and a folder's size on disk can be far less than the size
            of the files in it.
        </p>
    }
    else
    {
        <p class="check-detail">@VolumeDeduplication.NotInstalledNote</p>
    }
}

@code {
    // Low is amber, critical red (VolumeUsage.LowFreeFraction, CriticalFreeFraction).
    private static string? FreeClass(FreeSpaceLevel level) => level switch
    {
        FreeSpaceLevel.Critical => "check-bad",
        FreeSpaceLevel.Low => "check-warn",
        _ => null,
    };

    private HostAddresses? addresses;
    private HostSystem? system;
    private DomainCheck? domain;
    private IReadOnlyList<VolumeUsage>? volumes;

    private CancellationTokenSource? cts;

    /// The local reads that cost nothing, ready for the first paint. The volumes
    /// are not among them: see <see cref="ReadVolumesAsync"/>.
    protected override void OnInitialized()
    {
        system = Host.System();
        addresses = HostInspector.Local();
    }

    /// The two answers that need the network — a request to a third party and a
    /// DNS lookup. Deliberately not in OnInitializedAsync: that runs during
    /// prerender, where an await holds back the HTTP response itself and the
    /// browser gets nothing at all until both have returned. OnAfterRender does
    /// not run during prerender, so these land in a page that is already up.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        cts = new CancellationTokenSource();

        // Started first and awaited last: the volumes are local and usually back
        // before the public address, and neither waits on the other.
        var storage = ReadVolumesAsync(cts.Token);

        try
        {
            addresses = await Host.AddressesAsync(cts.Token);
            StateHasChanged();

            domain = await Host.CheckDomainAsync(cts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Navigating away before the lookups came back.
        }

        await storage;
    }

    /// <summary>The Storage table's rows, read once per page open.</summary>
    /// <remarks>
    /// <para>After the first paint and on the thread pool, not in
    /// <c>OnInitialized</c>: a volume's drive type and deduplication state are
    /// Windows queries (CIM in <c>root\Microsoft\Windows\Storage</c>, and the
    /// broker), synchronous and slow next to the rest of the page. In
    /// <c>OnInitialized</c> they ran during prerender, holding back the HTTP
    /// response, and again on the interactive render, holding the circuit, so
    /// the Status page opened late every time.</para>
    /// <para>Not on the page's one-second tick either: free space does not move
    /// meaningfully between renders.</para>
    /// </remarks>
    private async Task ReadVolumesAsync(CancellationToken cancellationToken)
    {
        var directories = Registry.All.Select(s => s.WorkingDirectory).ToList();
        var root = Registry.Root;

        try
        {
            var read = await Task.Run(() => Host.Volumes(directories, root), cancellationToken);

            if (!cancellationToken.IsCancellationRequested)
            {
                volumes = read;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away before the read started.
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    private static string DomainStateClass(DomainCheckResult result) => result switch
    {
        DomainCheckResult.Matches => "good",
        DomainCheckResult.Mismatch => "missing",
        _ => "unknown",
    };
}
