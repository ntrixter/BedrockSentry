<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ASP.NET Core + Blazor Server control panel, hosted as a Windows Service.
  -->

  <PropertyGroup>
    <!--
      Pinned explicitly rather than inherited from the project filename. Four
      separate things have to agree on this string: the assembly name, the
      @Assets["BedrockSentry.Host.styles.css"] key in App.razor, the
      BedrockSentry.Host.staticwebassets.endpoints.json manifest that
      MapStaticAssets loads, and the scoped-CSS bundle name the SDK emits.
      Two of those fail at startup and two fail silently — @Assets passes an
      unknown key straight through to a 404, so a mismatch shows up as an app
      with no styling and nothing in the log.
    -->
    <AssemblyName>BedrockSentry.Host</AssemblyName>
    <RootNamespace>BedrockSentry.Host</RootNamespace>
    <UserSecretsId>bedrocksentry-host</UserSecretsId>

    <!-- Nothing here is ever hosted under IIS; skip the web.config rewrite. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>

    <!-- NavigationManager.NavigateTo shouldn't throw on the way out of a handler. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!--
      Both false, deliberately, and set here rather than in Directory.Build.props
      because the Updater needs the opposite (see its .csproj). Trimming a Blazor
      app is unsafe — Razor components resolve through reflection, so the trimmer
      removes types that are only ever constructed dynamically, and the damage
      surfaces at runtime on a page nobody exercised. Single-file breaks
      MapStaticAssets, which needs a real manifest file on disk beside the exe.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The companion pack, beside the executable in every build and every release
      archive. CompanionPackSeeder adds it to the add-on library at each start
      (D93), and scripts/ReleaseContents.ps1 fails a release without its files.
      README.md is the repository's description of the folder, not part of the
      pack, and CompanionPackTests hash exactly this set.
    -->
    <None Include="..\..\companion-pack\**\*"
          Exclude="..\..\companion-pack\README.md"
          LinkBase="companion-pack"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- D109. The companion's resource pack, which defines the line outlines are drawn
         with, beside it and seeded the same way. -->
    <None Include="..\..\companion-resources\**\*"
          Exclude="..\..\companion-resources\README.md"
          LinkBase="companion-resources"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BedrockSentry.Core\BedrockSentry.Core.csproj" />
    <ProjectReference Include="..\BedrockSentry.Services\BedrockSentry.Services.csproj" />
  </ItemGroup>

</Project>
