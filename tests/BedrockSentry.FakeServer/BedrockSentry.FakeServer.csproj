<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for bedrock_server.exe, used by the test suite.

    Exists so BedrockProcess is tested against a real child process with real
    pipes rather than a mock: encoding, line handling, stdin flushing and exit
    codes are precisely the things a mock would agree with and an OS would not.

    Plain net10.0 rather than the solution default, so the process tests run on
    a Linux build agent as well as on Windows. It is never packaged or shipped —
    the real server always comes from Mojang, as its usage guidelines require.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>fake-bedrock-server</AssemblyName>
  </PropertyGroup>

</Project>
