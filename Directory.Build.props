<Project>

  <!--
    Shared build settings for every BedrockSentry project. Individual project
    files carry only what makes them different.

    Target framework (D9, resolved): BedrockSentry is a Windows-only product,
    so `net10.0-windows` is the default here. BedrockSentry.Core overrides
    back to plain `net10.0` in its own .csproj — it has no Windows dependency,
    and staying platform-neutral means the analyzer flags any accidental
    Windows coupling that creeps in there, plus keeps the door open to a
    future Linux port of the non-Windows-specific parts.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Product>BedrockSentry</Product>
    <Authors>ntrixter</Authors>
    <Copyright>Copyright (c) 2026 ntrixter</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The only version input anyone edits by hand. CI appends the run number to
      produce e.g. 0.3.0-build.57, and the SDK appends "+<commit sha>" to
      InformationalVersion on top of that (SourceLink is on by default, so the
      commit costs nothing). BuildInfo parses the pair back apart at runtime.

      Version answers "which build is this"; the commit answers "is there an
      update". They are not interchangeable — on the build channel this prefix
      never moves, so comparing versions alone would never detect an update.
    -->
    <VersionPrefix>0.4.0</VersionPrefix>

    <!--
      D114. Raised by one on a build an installed wrapper must not reach by
      self-update, and never lowered. The build carries it (BuildInfo.InstallEpoch)
      and release.yml writes it into the channel manifest as installEpoch; a wrapper
      refuses a manifest whose epoch is above its own and offers a reinstall instead.
      1 from the broker build (D118): a LocalSystem install reinstalls rather than updates.
    -->
    <BedrockSentryInstallEpoch>1</BedrockSentryInstallEpoch>

    <!-- Overridden by CI with -p:BedrockSentryChannel=build|stable. -->
    <BedrockSentryChannel Condition="'$(BedrockSentryChannel)' == ''">local</BedrockSentryChannel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      An item rather than a property because -p: cannot set items, and this has to
      survive into the assembly for BuildInfo to read back. Deliberately no build
      timestamp here: a value that changes on every MSBuild evaluation forces a
      rebuild between 'build' and 'publish' and defeats reproducible builds.
    -->
    <AssemblyMetadata Include="Channel" Value="$(BedrockSentryChannel)" />
    <AssemblyMetadata Include="InstallEpoch" Value="$(BedrockSentryInstallEpoch)" />
  </ItemGroup>

  <!--
    The branch the build came from, shown in the panel's footer and top row
    (BuildInfo.Branch). -p:BedrockSentryBranch wins; on GitHub Actions the pull
    request's head or the pushed branch; otherwise git, asked once at build time.
    A detached HEAD or no git at all leaves it empty and the panel shows the
    version alone. A target rather than a property, because evaluation cannot run
    git; it lands before GetAssemblyAttributes turns metadata into attributes.
  -->
  <Target Name="BedrockSentryStampBranch" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_BedrockSentryBranch>$(BedrockSentryBranch)</_BedrockSentryBranch>
      <_BedrockSentryBranch Condition="'$(_BedrockSentryBranch)' == ''">$(GITHUB_HEAD_REF)</_BedrockSentryBranch>
      <_BedrockSentryBranch Condition="'$(_BedrockSentryBranch)' == '' and '$(GITHUB_REF_TYPE)' == 'branch'">$(GITHUB_REF_NAME)</_BedrockSentryBranch>
    </PropertyGroup>

    <Exec Condition="'$(_BedrockSentryBranch)' == ''"
          Command="git rev-parse --abbrev-ref HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          EchoOff="true" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BedrockSentryGitBranch" />
      <Output TaskParameter="ExitCode" PropertyName="_BedrockSentryGitExit" />
    </Exec>

    <PropertyGroup Condition="'$(_BedrockSentryBranch)' == '' and '$(_BedrockSentryGitExit)' == '0' and '$(_BedrockSentryGitBranch)' != 'HEAD'">
      <_BedrockSentryBranch>$(_BedrockSentryGitBranch.Trim())</_BedrockSentryBranch>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyMetadata Include="Branch" Value="$(_BedrockSentryBranch)" />
    </ItemGroup>
  </Target>

</Project>
